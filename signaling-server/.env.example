# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# JWT Secret for device session authTokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# TURN Provider Configuration (Metered.ca / Open Relay / Twilio)
# Example for Metered.ca:
# TURN_PROVIDER_API_KEY=your_metered_api_key
# TURN_PROVIDER_URL=https://your-app.metered.live/api/v1/turn/credentials
